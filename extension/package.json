{
  "name": "slop-marker-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "De-emphasizes likely-AI-generated prose. One source tree, Chrome + Firefox builds.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --browser=chrome",
    "build:firefox": "node scripts/build.mjs --browser=firefox",
    "bench": "node scripts/bench-ort.mjs"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "^4.2.0",
    "onnxruntime-web": "^1.29.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.28",
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.12",
    "eslint": "^10.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^3.2.4"
  }
}
