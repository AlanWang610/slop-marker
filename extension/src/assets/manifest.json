{
  "manifest_version": 3,
  "name": "slop-marker",
  "version": "0.1.0",
  "description": "De-emphasizes page text that a self-trained ModernBERT classifier judges likely AI-generated. All inference runs on-device.",
  "background": {
    "service_worker": "router-chrome.js",
    "type": "module",
    "scripts": [
      "router-firefox.js"
    ]
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://github.com/*",
    "https://release-assets.githubusercontent.com/*",
    "https://objects.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "slop-marker@localhost",
      "strict_min_version": "140.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
